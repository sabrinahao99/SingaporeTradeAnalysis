library(ganttrify)
library(ganttrify)
library(ganttify)
install.packages("ganttify")
library(ganttify)
gc <- gantt_chart(
y = c(
"Project Proposal",
"Data Collection",
"Data Cleaning",
"Exploratory Analysis",
"R Quarto Website",
"R Shiny App",
"Storyboard / Prototype",
"Poster"
),
x1 = as.Date(c(
"2026-02-05",
"2026-02-08",
"2026-02-12",
"2026-02-18",
"2026-02-20",
"2026-02-25",
"2026-03-10",
"2026-03-20"
)),
x2 = as.Date(c(
"2026-02-09",
"2026-02-16",
"2026-02-22",
"2026-03-05",
"2026-03-15",
"2026-03-22",
"2026-03-28",
"2026-04-01"
)),
status = c(
"Completed",
"Completed",
"Completed",
"In progress",
"In progress",
"In progress",
"In progress",
"In progress"
)
)
library(tidyverse)
# 任务数据
tasks <- tibble(
task = c(
"Project Proposal",
"Data Collection",
"Data Cleaning",
"Exploratory Analysis",
"R Quarto Website",
"R Shiny App",
"Storyboard / Prototype",
"Poster"
),
start = as.Date(c(
"2026-02-05",
"2026-02-08",
"2026-02-12",
"2026-02-18",
"2026-02-20",
"2026-02-25",
"2026-03-10",
"2026-03-20"
)),
end = as.Date(c(
"2026-02-09",
"2026-02-16",
"2026-02-22",
"2026-03-05",
"2026-03-15",
"2026-03-22",
"2026-03-28",
"2026-04-01"
)),
status = c(
"Completed",
"Completed",
"Completed",
"In progress",
"In progress",
"In progress",
"In progress",
"In progress"
)
)
# 为了让任务从上到下显示
tasks$task <- factor(tasks$task, levels = rev(tasks$task))
ggplot(tasks) +
geom_segment(
aes(x = start, xend = end, y = task, yend = task, color = status),
linewidth = 6
) +
geom_vline(
xintercept = as.Date("2026-04-01"),
color = "#E67E22",
linetype = "dashed",
linewidth = 1
) +
annotate(
"text",
x = as.Date("2026-04-01"),
y = 1,
label = "Final Due\n01 Apr",
color = "#E67E22",
hjust = -0.1,
vjust = -0.5,
size = 4
) +
scale_color_manual(
values = c(
"Completed" = "#2C3E50",
"In progress" = "#E67E22"
)
) +
labs(
title = "Project Timeline (Spring 2026)",
x = "Date",
y = NULL,
color = NULL
) +
theme_minimal(base_size = 12) +
theme(
legend.position = "top",
panel.grid.minor = element_blank(),
axis.text.y = element_text(face = "bold")
)
